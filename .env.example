# Copy this file to .env and add your eBay Production application keys.
EBAY_CLIENT_ID=your_client_id
EBAY_CLIENT_SECRET=your_client_secret
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=production
EBAY_ZIP_CODE=your_us_zip_code

# Daily underpriced listing email (SMTP)
EMAIL_TO=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=mewtwo-finder@example.com
# Set true only for providers requiring implicit TLS on SMTP_PORT (often 465).
SMTP_USE_SSL=false
